# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Your Discord user ID (right-click your name -> Copy User ID). DM + admin commands go here.
OWNER_ID=

# Optional: a server text channel ID where followed-title news is also posted.
NEWS_CHANNEL_ID=

# Tuning (all optional)
LEARN_INTERVAL=900
WATCH_INTERVAL=1800
MATCH_THRESHOLD=78
EMOE_REFRESH=3600
